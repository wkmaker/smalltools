{
  "name": "smalltools",
  "version": "1.29.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node tests/check-ui-standards.mjs && node tests/audit-seo.mjs && node tests/verify-all-faqs.js && node tests/test-og-translations.mjs && node tests/test-og-constants.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/test-all-translations.mjs && npm run test:engine",
    "test:ui": "node tests/check-ui-standards.mjs",
    "test:seo": "node tests/audit-seo.mjs",
    "test:faq": "node tests/verify-all-faqs.js",
    "test:og": "node tests/test-og-translations.mjs && node tests/test-og-constants.mjs",
    "test:i18n": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/test-all-translations.mjs",
    "audit:aria": "node tests/audit-aria-labels.mjs",
    "test:engine": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/engine/**/*.test.mjs\"",
    "test": "npm run test:ui && npm run test:seo && npm run test:faq && npm run test:og && npm run test:i18n && npm run test:engine",
    "build": "next build",
    "start": "next start",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@peculiar/x509": "^2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "bignumber.js": "^11.1.5",
    "diff": "^9.0.0",
    "echarts": "^6.1.0",
    "hash-wasm": "^4.12.0",
    "next": "^16.4.2",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qr-code-styling": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^24.19.2",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "js-yaml": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
